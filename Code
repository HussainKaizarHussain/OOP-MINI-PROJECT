#include <iostream>
#include <vector>
#include <string>

using namespace std;

// 1. Book Class represents a single book
class Book {
private:
    int id;
    string title;
    string author;
    bool isAvailable;

public:
    // Constructor
    Book(int bookId, string bookTitle, string bookAuthor) {
        id = bookId;
        title = bookTitle;
        author = bookAuthor;
        isAvailable = true; // New books are available by default
    }

    // Getter methods
    int getId() { return id; }
    string getTitle() { return title; }
    string getAuthor() { return author; }
    bool getAvailability() { return isAvailable; }

    // Setter method to change status
    void setAvailability(bool status) {
        isAvailable = status;
    }

    // Display book details
    void display() {
        cout << "ID: " << id 
             << " | Title: " << title 
             << " | Author: " << author 
             << " | Status: " << (isAvailable ? "Available" : "Issued") << endl;
    }
};

// 2. Library Class manages the collection of books
class Library {
private:
    vector<Book> books; // List to store books in memory

public:
    // Add a new book
    void addBook() {
        int id;
        string title, author;

        cout << "Enter Book ID: ";
        cin >> id;
        
        // Check if ID already exists
        for (int i = 0; i < books.size(); i++) {
            if (books[i].getId() == id) {
                cout << "Error: A book with this ID already exists!\n";
                return;
            }
        }

        cin.ignore(); // Clear input buffer
        cout << "Enter Book Title: ";
        getline(cin, title);
        cout << "Enter Book Author: ";
        getline(cin, author);

        books.push_back(Book(id, title, author));
        cout << "Book added successfully!\n";
    }

    // Display all books
    void displayAllBooks() {
        if (books.empty()) {
            cout << "The library is empty.\n";
            return;
        }

        cout << "\n--- LIBRARY BOOKS ---\n";
        for (int i = 0; i < books.size(); i++) {
            books[i].display();
        }
        cout << "---------------------\n";
    }

    // Search book by ID using a simple for loop
    void searchBook() {
        int id;
        cout << "Enter Book ID to search: ";
        cin >> id;

        for (int i = 0; i < books.size(); i++) {
            if (books[i].getId() == id) {
                cout << "Book Found:\n";
                books[i].display();
                return;
            }
        }
        cout << "Book with ID " << id << " not found.\n";
    }

    // Issue a book
    void issueBook() {
        int id;
        cout << "Enter Book ID to issue: ";
        cin >> id;

        for (int i = 0; i < books.size(); i++) {
            if (books[i].getId() == id) {
                if (!books[i].getAvailability()) {
                    cout << "Sorry, this book is already issued.\n";
                    return;
                }
                books[i].setAvailability(false);
                cout << "Book issued successfully!\n";
                return;
            }
        }
        cout << "Book not found.\n";
    }

    // Return a book
    void returnBook() {
        int id;
        cout << "Enter Book ID to return: ";
        cin >> id;

        for (int i = 0; i < books.size(); i++) {
            if (books[i].getId() == id) {
                if (books[i].getAvailability()) {
                    cout << "This book is already in the library (not issued).\n";
                    return;
                }
                books[i].setAvailability(true);
                cout << "Book returned successfully!\n";
                return;
            }
        }
        cout << "Book not found.\n";
    }
};

// Main function with Menu
int main() {
    Library myLibrary;
    int choice;

    do {
        cout << "\n===== LIBRARY MENU =====\n";
        cout << "1. Display All Books\n";
        cout << "2. Add New Book\n";
        cout << "3. Search Book by ID\n";
        cout << "4. Issue Book\n";
        cout << "5. Return Book\n";
        cout << "6. Exit\n";
        cout << "Enter your choice (1-6): ";
        cin >> choice;

        switch (choice) {
            case 1:
                myLibrary.displayAllBooks();
                break;
            case 2:
                myLibrary.addBook();
                break;
            case 3:
                myLibrary.searchBook();
                break;
            case 4:
                myLibrary.issueBook();
                break;
            case 5:
                myLibrary.returnBook();
                break;
            case 6:
                cout << "Exiting program. Goodbye!\n";
                break;
            default:
                cout << "Invalid choice! Please select between 1 and 6.\n";
        }
    } while (choice != 6);

    return 0;
}
